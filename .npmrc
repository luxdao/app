# The @hanzo/gui umbrella resolves its subpackages against a flat tree and fails
# at install rather than at build if it does not get one. Recorded because the
# symptom is a broken tree, not an error.
node-linker=hoisted

# Peer ranges across the @hanzogui/* packages are mid-migration between majors.
# Let the resolver settle them and report what it could not, rather than pinning
# by hand: an override that forces a peer is how a tree ends up with several
# copies of one package at different paths.
strict-peer-dependencies=false
